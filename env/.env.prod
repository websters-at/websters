APP_NAME=Websters
APP_ENV=production
APP_KEY=base64:u33CD2htX/5rtvLEX7Y+vGEXax9b6FI0iptWGE9gmS0=
APP_DEBUG=false
APP_URL=https://websters.at
ASSET_URL=https://websters.at

# Locale and other config...
APP_LOCALE=de
APP_FALLBACK_LOCALE=en

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Database (match your compose secrets)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=webstersdb
DB_USERNAME=admin
DB_PASSWORD=password

# Session/Cookie settings (must match live: redis-backed)
SESSION_DRIVER=redis
SESSION_DOMAIN=websters.at
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Cache/Queue (must match live: redis-backed; database drivers are dev-only)
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Redis (values injected at deploy time; never commit real passwords)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail (log default is intentional: the app currently sends no mail;
# set MAIL_MAILER=smtp + credentials when transactional mail is added)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=office@websters.at
MAIL_FROM_NAME=Websters

# Vite
VITE_APP_NAME=Websters

# Reverse Proxy settings
TRUSTED_PROXIES=*
TRUSTED_HOSTS=websters.at

# Octane/FrankenPHP
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true
